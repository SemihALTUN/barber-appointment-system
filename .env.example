# Uygulama veritabanı (docker-compose varsayılanı)
DATABASE_URL="postgresql://barber:barber_local_pw@localhost:5433/barber_db?sslmode=disable"

# Upstash Redis — boş bırakılırsa slot kilidi ve rate limit devre dışı kalır (DB katmanı korumaya devam eder)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Auth.js
AUTH_SECRET=""                 # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_TRUST_HOST="true"

# NoShowTracker HMAC anahtarı
NO_SHOW_PEPPER=""              # en az 32 karakter
NO_SHOW_PEPPER_VERSION="1"

# /api/cron/anonymize için Bearer token
CRON_SECRET=""
